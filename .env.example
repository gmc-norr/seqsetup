## SeqSetup deployment environment.
## Copy to `.env` and fill in real values. .env is gitignored.

## --- Required ---

# Session signing key. Must be >= 32 characters; recommend `secrets.token_hex(32)`
# which produces 64 hex chars. App fails closed on a shorter value.
SEQSETUP_SESSION_SECRET=

# Mongo root credentials are NOT here: they live in .env.db, which only the
# mongod container reads (copy .env.db.example). The app reads the whole of
# this file, and it never needs the root credential.

# Mongo application credentials — what the app uses to read/write. Created
# by docker/mongo-init.sh on first start.
#
# Generate the password with `openssl rand -hex 24`, and use nothing else.
# Two things read it and neither is safe for arbitrary text:
#   * The app's MONGODB_URI carries it. A URI cannot carry : / ? # @ [ ] or a
#     space unencoded, and reads a % followed by two hex digits as an encoded
#     character -- such a password would be SENT as something else. Compose
#     cannot encode it for you.
#   * Compose's env-file parser reads this file. Measured: `$HOME` is replaced
#     with the HOST's value, `$$` becomes `$`, a wrapping " or ' is stripped,
#     and a ` #' cuts the rest of the line. None of it is reported.
# Hex avoids all of it. docker/mongo-init.sh, which creates the user, takes
# any character itself.
MONGO_APP_USER=seqsetup_app
MONGO_APP_PASSWORD=

# 1 when users reach SeqSetup over HTTPS (through your TLS proxy): the session
# cookie is marked Secure and browsers are told to use only HTTPS (HSTS).
# 0 only for a trial over plain HTTP. Any other value stops the start.
SEQSETUP_HTTPS_ONLY=1

## --- Recommended for production ---

# Behind a TLS proxy: your public HTTPS origin(s), comma-separated, for example
# https://seqsetup.example.com. Without it, form posts through the proxy are
# refused (403). See docs/getting-started/deployment.rst, Reverse Proxy Configuration.
SEQSETUP_TRUSTED_ORIGINS=

# 1 behind a reverse proxy that REPLACES X-Forwarded-For with the client's address
# (the nginx example in docs/getting-started/deployment.rst does): each user then
# gets their own sign-in limit instead of every user sharing the proxy's address.
# 0 when SeqSetup can be reached without that proxy — the header is then whatever
# the client typed, and a client could spend anyone's limit.
SEQSETUP_TRUST_FORWARDED_FOR=1

# The address docker-compose publishes the app's port on. Unset: 127.0.0.1, so
# only this server (and a TLS proxy on it) can reach the app. Set it to this
# server's address on another network only when the proxy runs on another machine.
# SEQSETUP_PUBLISH_ADDRESS=

# The time zone SeqSetup shows times in: an IANA name such as Europe/Stockholm.
# Unset: the server's own zone (usually UTC in a container). An unknown name
# stops the start. See docs/getting-started/deployment.rst, Time Zone.
# TZ=Europe/Stockholm

## --- Optional: external integrations (only when used) ---

# LIMS API key. The only place it can be set: the admin page has no key box.
SEQSETUP_LIMS_API_KEY=

# Minimum interval between LIMS requests per host, in ms. Default 100.
SEQSETUP_LIMS_MIN_INTERVAL_MS=100

# Allow plain HTTP to a non-localhost LIMS. NOT FOR PRODUCTION.
SEQSETUP_LIMS_ALLOW_HTTP=0

# The networks a LIMS may be on, comma-separated CIDR, for a LIMS that is not on
# a public address: for example 10.0.0.0/8,192.168.10.0/24. Unset: public only.
# Link-local, multicast, unspecified and reserved addresses are refused however
# they are listed. SEQSETUP_LIMS_ALLOW_PRIVATE_NETS is gone: it allowed every
# private address at once, and SeqSetup now refuses to start while it is set.
SEQSETUP_LIMS_ALLOWED_NETS=

# Login + API rate limit knobs (sliding window).
SEQSETUP_LOGIN_RATE_LIMIT=20
SEQSETUP_LOGIN_RATE_WINDOW=60
SEQSETUP_API_RATE_LIMIT=100
SEQSETUP_API_RATE_WINDOW=60

## --- Optional: sign-in and limits ---

# How long a login lasts, in seconds: unused (default 1800 = 30 minutes; 60 up
# to the max age) and in all (default 28800 = 8 hours; 300 to 86400). A value
# outside its range is used at the nearest end, with a warning in the log; a
# value that is not a whole number stops the start.
# SEQSETUP_SESSION_IDLE_SECONDS=1800
# SEQSETUP_SESSION_MAX_AGE_SECONDS=28800

# The most samples one run may hold. Default 5000. Checking a run takes time
# that grows with the square of its samples, so raise it only for very
# high-plex work. A value that is not a whole number above 0 is ignored and
# 5000 is used.
# SEQSETUP_MAX_SAMPLES_PER_RUN=5000

# 1 lets LDAP/AD sign-in use an unencrypted connection: every password would be
# sent readable. Only on a trusted, isolated network. NOT FOR PRODUCTION.
# SEQSETUP_LDAP_ALLOW_CLEARTEXT=0

# An instruments YAML file to read instead of config/instruments.yaml, as a
# path the app can read (in Docker, config/ is at /app/config). Set, it
# decides; a path that is not a file stops the start.
# INSTRUMENTS_CONFIG=
