## SeqSetup deployment environment.
## Copy to `.env` and fill in real values. .env is gitignored.

## --- Required ---

# Session signing key. Must be >= 32 characters; recommend `secrets.token_hex(32)`
# which produces 64 hex chars. App fails closed on a shorter value.
SEQSETUP_SESSION_SECRET=

# Mongo root credentials — used only by the mongod container for admin tasks.
# Pick strong values; these don't appear in app code.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=

# Mongo application credentials — what the app uses to read/write. Created
# by docker/mongo-init.js on first start.
MONGO_APP_USER=seqsetup_app
MONGO_APP_PASSWORD=

# 1 when users reach SeqSetup over HTTPS (through your TLS proxy): the session
# cookie is marked Secure and browsers are told to use only HTTPS (HSTS).
# 0 only for a trial over plain HTTP. Any other value stops the start.
SEQSETUP_HTTPS_ONLY=1

## --- Recommended for production ---

# The time zone SeqSetup shows times in: an IANA name such as Europe/Stockholm.
# Unset: the server's own zone (usually UTC in a container). An unknown name
# stops the start. See docs/getting-started/deployment.rst, Time Zone.
# TZ=Europe/Stockholm

## --- Optional: external integrations (only when used) ---

# LIMS API key. Same env-over-DB pattern.
SEQSETUP_LIMS_API_KEY=

# Comma-separated allow-list of additional Origin values (e.g. when running
# behind a load balancer that rewrites Host).
SEQSETUP_TRUSTED_ORIGINS=

# The address docker-compose publishes the app's port on. Unset: 127.0.0.1, so
# only this server (and a TLS proxy on it) can reach the app. Set it to this
# server's address on another network only when the proxy runs on another machine.
# SEQSETUP_PUBLISH_ADDRESS=

# Minimum interval between LIMS requests per host, in ms. Default 100.
SEQSETUP_LIMS_MIN_INTERVAL_MS=100

# Allow plain HTTP to a non-localhost LIMS. NOT FOR PRODUCTION.
SEQSETUP_LIMS_ALLOW_HTTP=0

# Login + API rate limit knobs (sliding window).
SEQSETUP_LOGIN_RATE_LIMIT=20
SEQSETUP_LOGIN_RATE_WINDOW=60
SEQSETUP_API_RATE_LIMIT=100
SEQSETUP_API_RATE_WINDOW=60
